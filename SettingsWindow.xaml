<Window x:Class="EdgeSwitch.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EdgeSwitch settings"
        Icon="pack://application:,,,/Assets/EdgeSwitch.ico"
        Width="600" Height="650" MinWidth="440" MinHeight="360"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        ShowInTaskbar="False" FontFamily="Segoe UI" FontSize="13"
        Background="{DynamicResource SurfaceBrush}"
        Foreground="{DynamicResource TextBrush}">
    <Window.Resources>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Padding="10,8" Margin="2"
                                Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1E3A5F" />
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource BorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="MaxDropDownHeight" Value="240" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="FieldBorder" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" />
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent">
                                            <Path Data="M 0 0 L 4 4 L 8 0" StrokeThickness="1.5"
                                                  Stroke="{DynamicResource MutedBrush}"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Margin="0,0,12,0" />
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="11,8,32,8" IsHitTestVisible="False"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                                   Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Background="{DynamicResource PanelBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="5" Margin="0,3,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ProcessCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="RowBorder" Padding="{TemplateBinding Padding}"
                                Background="Transparent" CornerRadius="4" BorderThickness="1"
                                BorderBrush="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="18" Height="18" Margin="0,0,11,0"
                                        VerticalAlignment="Center" CornerRadius="3"
                                        BorderBrush="{DynamicResource MutedBrush}" BorderThickness="1"
                                        Background="{DynamicResource SurfaceBrush}">
                                    <Path x:Name="CheckMark" Data="M 2 7 L 6 11 L 13 3"
                                          Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"
                                          Visibility="Collapsed" />
                                </Border>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center"
                                                  RecognizesAccessKey="True" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="#293548" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="RowBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="Toolbar settings" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="Choose your windows and where EdgeSwitch appears."
                       Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" TextWrapping="Wrap" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,8,0">
                <TextBlock Text="Captured executables" FontSize="15" FontWeight="SemiBold" />
                <TextBlock Text="Checked apps appear in the toolbar. You can also add an app that is not running."
                           Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,8" />
                <Label Content="_Executable name or path" Target="{Binding ElementName=ProcessNameInput}"
                       Foreground="{DynamicResource TextBrush}" Padding="0,0,0,5" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ProcessNameInput" VerticalContentAlignment="Center"
                             AutomationProperties.Name="Executable name or path"
                             AutomationProperties.HelpText="Type an executable such as mstsc.exe, then press Enter or Add."
                             ToolTip="For example: mstsc.exe or C:\Windows\System32\mstsc.exe"
                             KeyDown="ProcessNameInput_KeyDown" />
                    <Button x:Name="AddProcessButton" Grid.Column="1" Content="_Add" Margin="8,0,0,0"
                            MinWidth="58" Click="AddProcessButton_Click"
                            AutomationProperties.Name="Add executable" />
                    <Button Grid.Column="2" Content="_Browse…" Margin="8,0,0,0"
                            Click="BrowseButton_Click" AutomationProperties.Name="Browse for executable" />
                </Grid>
                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="6" Margin="0,10,0,18" Padding="4">
                    <ScrollViewer Height="154" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="CaptureList" AutomationProperties.Name="Executable capture choices">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsCaptured, Mode=TwoWay}"
                                              AutomationProperties.Name="{Binding DisplayName}"
                                              Style="{StaticResource ProcessCheckBoxStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding DisplayName}" />
                                            <TextBlock Grid.Column="1" Text="{Binding WindowCountText}" FontSize="11"
                                                       Foreground="{DynamicResource MutedBrush}" Margin="12,0,0,0"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
                <TextBlock Text="Placement" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                        <Label Content="Toolbar ed_ge" Target="{Binding ElementName=EdgePicker}"
                               Foreground="{DynamicResource TextBrush}" Padding="0,0,0,5" />
                        <ComboBox x:Name="EdgePicker" DisplayMemberPath="DisplayName" SelectedValuePath="Edge"
                                  AutomationProperties.Name="Toolbar edge" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <Label Content="_Display" Target="{Binding ElementName=MonitorPicker}"
                               Foreground="{DynamicResource TextBrush}" Padding="0,0,0,5" />
                        <ComboBox x:Name="MonitorPicker" DisplayMemberPath="DisplayName"
                                  AutomationProperties.Name="Toolbar display" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="The first word chooses the trigger edge and toolbar direction; the second aligns it along that edge. Plain edges are centered. Hover over the portion of the edge occupied by the toolbar to reveal it."
                           Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,7,0,0" />
                <TextBlock Text="Automatic uses the selected edge only where displays do not meet."
                           Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,7,0,0" />
                <TextBlock x:Name="MonitorWarning" Foreground="#FBBF24" TextWrapping="Wrap"
                           Visibility="Collapsed" Margin="0,7,0,0"
                           AutomationProperties.LiveSetting="Polite" />
                <Label Content="_Hide delay" Target="{Binding ElementName=HideDelayInput}"
                       Foreground="{DynamicResource TextBrush}" Padding="0" Margin="0,16,0,5" />
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="HideDelayInput" Width="90" VerticalContentAlignment="Center"
                             AutomationProperties.Name="Hide delay in milliseconds"
                             AutomationProperties.HelpText="A whole number between 200 and 5000 milliseconds." />
                    <TextBlock Text="milliseconds (200–5,000)" VerticalAlignment="Center"
                               Margin="10,0,0,0" Foreground="{DynamicResource MutedBrush}" />
                </StackPanel>
                <TextBlock Text="How long the toolbar stays open after the pointer leaves it."
                           Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,7,0,8" />
                <TextBlock Text="Remote Desktop" FontSize="15" FontWeight="SemiBold" Margin="0,16,0,4" />
                <CheckBox x:Name="AlwaysMakeRemoteDesktopSessionFullscreenCheckBox"
                          Style="{StaticResource ProcessCheckBoxStyle}"
                          AutomationProperties.Name="Always maximize remote desktop sessions"
                          AutomationProperties.HelpText="Maximize a remote desktop session when you click its toolbar entry. Already-maximized or fullscreen sessions are unchanged. The remote client controls whether maximizing enters fullscreen.">
                    <TextBlock Text="Always maximize remote desktop sessions" TextWrapping="Wrap" />
                </CheckBox>
                <TextBlock Text="Off by default. Maximizes the session when you click its entry. The remote client controls whether maximizing enters fullscreen."
                           Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,8" />
                <TextBlock Text="Startup" FontSize="15" FontWeight="SemiBold" Margin="0,16,0,4" />
                <CheckBox x:Name="StartWithWindowsCheckBox"
                          Content="Start EdgeSwitch when I sign _in"
                          Style="{StaticResource ProcessCheckBoxStyle}"
                          AutomationProperties.Name="Start EdgeSwitch when I sign in"
                          AutomationProperties.HelpText="Start automatically when you sign in to Windows. Applies only to your account after choosing Save." />
                <TextBlock Text="Off by default. Applies only to your Windows account after you choose Save."
                           Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,8" />
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                Margin="0,16,0,0" Padding="0,14,0,0">
            <StackPanel>
                <TextBlock x:Name="ErrorMessage" Foreground="#FCA5A5" TextWrapping="Wrap"
                           Visibility="Collapsed" Margin="0,0,0,10"
                           AutomationProperties.Name="Settings error" AutomationProperties.LiveSetting="Assertive" />
                <TextBlock Text="Changes are applied and saved only when you choose Save."
                           Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton" Content="_Cancel" IsCancel="True" MinWidth="86"
                            Click="CancelButton_Click" AutomationProperties.Name="Cancel settings" />
                    <Button x:Name="SaveButton" Content="_Save" MinWidth="86" Margin="8,0,0,0"
                            Background="#1D4ED8" BorderBrush="#3B82F6" Foreground="#FFFFFF"
                            Click="SaveButton_Click" AutomationProperties.Name="Save settings" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
