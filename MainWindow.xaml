<Window x:Class="EdgeSwitch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EdgeSwitch" WindowStyle="None" ResizeMode="NoResize"
        Icon="pack://application:,,,/Assets/EdgeSwitch.ico"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        Width="54" Height="54" PreviewKeyDown="OnPreviewKeyDown"
        Style="{StaticResource {x:Type Window}}"
        AutomationProperties.Name="EdgeSwitch toolbar">
  <Border x:Name="ToolbarChrome" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="4">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <DockPanel x:Name="ToolbarLayout" LastChildFill="True">
        <Button x:Name="AppButton" DockPanel.Dock="Top" Width="40" Height="40" Padding="7" Margin="2"
                HorizontalAlignment="Left" VerticalAlignment="Top" Click="OnSettingsClick"
                AutomationProperties.Name="EdgeSwitch settings" ToolTip="EdgeSwitch — Settings">
          <Image Source="pack://application:,,,/Assets/EdgeSwitch.ico" Width="24" Height="24"
                 RenderOptions.BitmapScalingMode="HighQuality" />
        </Button>
        <Border x:Name="EntrySeparator" DockPanel.Dock="Top" Height="1" Margin="2,4"
                Background="{StaticResource BorderBrush}" />
        <ScrollViewer x:Name="WindowScroller" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
          <ItemsControl x:Name="WindowItems" AutomationProperties.Name="Captured windows">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="{Binding CardOrientation, RelativeSource={RelativeSource AncestorType=Window}}" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Click="OnWindowClick" Tag="{Binding}" Margin="2" Padding="7" Height="40"
                        MinWidth="40" HorizontalAlignment="Left" HorizontalContentAlignment="Left"
                        AutomationProperties.Name="{Binding Title}" ToolTip="{Binding ToolTip}">
                  <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                          <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                          <Setter Property="Background" Value="#20334D" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Button.Style>
                  <StackPanel Orientation="Horizontal">
                    <Image Source="{Binding Icon}" Width="24" Height="24"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel x:Name="RemoteSessionLabel" Orientation="Horizontal" Visibility="Collapsed"
                                VerticalAlignment="Center">
                      <TextBlock Text="-" Margin="4,0,2,0" />
                      <TextBlock Text="{Binding SessionName}" MaxWidth="160" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </StackPanel>
                </Button>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding IsRemoteDesktop}" Value="True">
                    <Setter TargetName="RemoteSessionLabel" Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
      <TextBlock x:Name="StatusText" Grid.Row="1" TextWrapping="Wrap" Visibility="Collapsed" MaxWidth="240"
                 HorizontalAlignment="Left" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="2,4,2,2"
                 AutomationProperties.LiveSetting="Polite" />
    </Grid>
  </Border>
</Window>
